    CONTROL         "",IDC_RATE_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | TBS_BOTH | WS_TABSTOP,7,53,226,18
    LTEXT           "Slower",IDC_SLOWER_LABEL,10,74,80,8
    RTEXT           "Faster",IDC_FASTER_LABEL,150,74,80,8
    CONTROL         "Show in the &right-click menu",IDC_CONTEXT_MENU,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,90,226,10
